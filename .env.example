# Copy to .env at the repository root; restart the backend after edits.
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2:3b
OLLAMA_URL=http://127.0.0.1:11434

# Set LLM_PROVIDER=openrouter to use only free inference. Never commit the key.
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_API_KEY=
# GigaChat authorization key for an individual (GIGACHAT_API_PERS).
GIGACHAT_CREDENTIALS=
PORT=8080
